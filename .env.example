# Supabase — required for the app to start
# These variables are server-only (no PUBLIC_ prefix, not exposed to client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# E2E testing credentials (used by Playwright)
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=your-test-password
TEST_NEW_USER_PASSWORD=your-new-test-password

# Do not expose SUPABASE_SERVICE_ROLE_KEY to Astro public/client code.
# Configure service-role secrets only in server-only tooling if a future task requires them.
