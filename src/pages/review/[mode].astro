---
import AppLayout from '../../layouts/AppLayout.astro'
import ReviewCard from '../../components/cards/ReviewCard.vue'
import { CreateSessionUseCase } from '../../use-cases/create-session'
import { SupabaseCardRepository } from '../../adapters/supabase/card-repository'
import type { Card, ReviewMode } from '../../types/app'
import { createSupabaseClient } from '../../lib/supabase'

const { mode } = Astro.params

// Validate mode
if (mode !== 'self-assessment' && mode !== 'quiz') {
  return Astro.redirect('/review')
}

const supabase = createSupabaseClient(Astro.request, Astro.cookies)
const { data: { user } } = await supabase.auth.getUser()
if (!user) return Astro.redirect('/login')

const repo = new SupabaseCardRepository(Astro.request, Astro.cookies)
const useCase = new CreateSessionUseCase(repo)

const domain = Astro.url.searchParams.get('domain') || undefined
const cards = await useCase.execute(user.id, domain)

if (cards.length === 0) {
  return Astro.redirect('/library?empty=true')
}

const reviewMode = mode as ReviewMode
---

<AppLayout title={reviewMode === 'self-assessment' ? 'Autoevaluación' : 'Quiz'} noScroll={reviewMode === 'quiz'}>
  <ReviewCard client:only="vue" cards={cards} mode={reviewMode} />
</AppLayout>


