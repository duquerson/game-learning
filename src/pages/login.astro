---
import BaseLayout from '../layouts/BaseLayout.astro'
import LoginForm from '../components/auth/LoginForm.vue'
---

<BaseLayout title="Iniciar sesión">
  <div class="auth-page">

    <!-- Fondo decorativo — HTML puro, sin JS, sin flash -->
    <div class="auth-bg" aria-hidden="true">
      <div class="blob blob-1"></div>
      <div class="blob blob-2"></div>
      <div class="blob blob-3"></div>
    </div>

    <div class="auth-content">
      <!-- Marca — visible antes de que Vue hidrate -->
      <div class="auth-brand">
        <span class="brand-icon" aria-hidden="true">🧠</span>
        <span class="brand-name">MicroLearn</span>
      </div>

      <!--
        Wrapper con min-height fijo = altura aproximada del formulario.
        Evita el CLS cuando Vue hidrata LoginForm.
        El formulario tiene max-width: 400px definido internamente.
      -->
      <div class="auth-form-slot">
        <LoginForm client:load />
      </div>
    </div>

  </div>
</BaseLayout>

<style>
  .auth-page {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
    overflow: hidden;
  }

  /* Blobs — position fixed para no afectar el flujo del documento */
  .auth-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
  }

  .blob-1 {
    width: 480px;
    height: 480px;
    top: -120px;
    left: -80px;
    background: var(--color-accent-purple);
    opacity: 0.25;
  }

  .blob-2 {
    width: 380px;
    height: 380px;
    bottom: -80px;
    right: -60px;
    background: var(--color-accent-pink);
    opacity: 0.2;
  }

  .blob-3 {
    width: 280px;
    height: 280px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: var(--color-accent-green);
    opacity: 0.12;
  }

  /* Contenido */
  .auth-content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 400px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
  }

  /* Marca */
  .auth-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-primary);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .brand-icon {
    font-size: 1.75rem;
    line-height: 1;
  }

  /*
    Reserva el espacio del formulario antes de que Vue hidrate.
    Altura aproximada del LoginForm (2 campos + botón + OAuth + link).
    Evita el CLS — el contenido no salta al montar el componente.
  */
  .auth-form-slot {
    width: 100%;
    min-height: 380px;
    display: flex;
    align-items: flex-start;
  }

  .auth-form-slot > * {
    width: 100%;
  }
</style>
