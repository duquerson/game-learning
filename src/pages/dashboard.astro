---
import AppLayout from '../layouts/AppLayout.astro'
import DashboardView from '../components/layout/Dashboard.vue'
import { createSupabaseClient } from '../lib/supabase'
import { createAppError, logServerError } from '../lib/errors'

const supabase = createSupabaseClient(Astro.request, Astro.cookies)
const { data: { user } } = await supabase.auth.getUser()
if (!user) return Astro.redirect('/login')

// User email for personalized greeting
const userEmail = user.email ?? ''

// Leer user_stats (total_points, current_streak, longest_streak)
const { data: statsData, error: statsError } = await supabase
  .from('user_stats')
  .select('total_points, current_streak, longest_streak')
  .eq('user_id', user.id)
  .maybeSingle()

if (statsError) {
  const appErr = createAppError('INTERNAL_ERROR', statsError.message, '/dashboard')
  logServerError(appErr)
}

// Calcular tarjetas repasadas hoy
const today = new Date().toISOString().split('T')[0]
const tomorrow = new Date(Date.now() + 86_400_000).toISOString().split('T')[0]

const { data: todayProgress, error: progressError } = await supabase
  .from('user_progress')
  .select('id')
  .eq('user_id', user.id)
  .gte('reviewed_at', `${today}T00:00:00.000Z`)
  .lt('reviewed_at', `${tomorrow}T00:00:00.000Z`)

if (progressError) {
  const appErr = createAppError('INTERNAL_ERROR', progressError.message, '/dashboard')
  logServerError(appErr)
}

// Total de tarjetas repasadas (todas, no solo hoy)
const { data: totalReviewedData, error: totalReviewedError } = await supabase
  .from('user_progress')
  .select('card_id', { count: 'exact', head: true })
  .eq('user_id', user.id)

if (totalReviewedError) {
  const appErr = createAppError('INTERNAL_ERROR', totalReviewedError.message, '/dashboard')
  logServerError(appErr)
}

// Total de tarjetas disponibles para los temas del usuario
const { data: prefs } = await supabase
  .from('user_preferences')
  .select('selected_topics')
  .eq('user_id', user.id)
  .single()

const topics: string[] = prefs?.selected_topics ?? []
let totalCards = 0
if (topics.length > 0) {
  const { count } = await supabase
    .from('cards')
    .select('id', { count: 'exact', head: true })
    .in('topic', topics)
  totalCards = count ?? 0
}

// Todas las insignias desbloqueadas (no solo 3)
const { data: allBadgesData, error: badgesError } = await supabase
  .from('user_badges')
  .select('unlocked_at, badges(id, name, description, icon, level, condition)')
  .eq('user_id', user.id)
  .order('unlocked_at', { ascending: false })

if (badgesError) {
  const appErr = createAppError('INTERNAL_ERROR', badgesError.message, '/dashboard')
  logServerError(appErr)
}

const totalPoints = statsData?.total_points ?? 0
const currentStreak = statsData?.current_streak ?? 0
const longestStreak = statsData?.longest_streak ?? 0
const cardsToday = todayProgress?.length ?? 0
const uniqueReviewed = totalReviewedData?.length ?? 0

const allBadges = (allBadgesData ?? []).map((ub: any) => ({
  id: ub.badges?.id ?? crypto.randomUUID(),
  name: ub.badges?.name ?? '',
  description: ub.badges?.description ?? '',
  icon: ub.badges?.icon ?? '',
  level: ub.badges?.level ?? 'basic',
  condition: ub.badges?.condition ?? { type: 'first_correct' },
  unlockedAt: ub.unlocked_at,
}))
---

<AppLayout title="Dashboard">
  <DashboardView
    client:idle
    totalPoints={totalPoints}
    currentStreak={currentStreak}
    longestStreak={longestStreak}
    cardsToday={cardsToday}
    uniqueReviewed={uniqueReviewed}
    totalCards={totalCards}
    userEmail={userEmail}
    allBadges={allBadges}
  />
</AppLayout>
