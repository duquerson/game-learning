---
import BaseLayout from '../layouts/BaseLayout.astro'
import { withBase } from '../lib/withBase'
---

<BaseLayout title="Error">
  <main id="main-content" class="error-page">
    <div class="error-content">
      <h1 class="error-title">Algo salió mal</h1>
      <p class="error-desc">Ocurrió un error inesperado. Intenta de nuevo o vuelve al inicio.</p>
      <div class="error-actions">
        <button class="error-btn" onclick="window.location.reload()">Reintentar</button>
        <a href={withBase('/')} class="error-btn secondary">Volver al inicio</a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
.error-page {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100dvh;
  padding: 2rem;
}
.error-content {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.75rem;
  max-width: 420px;
}
.error-title {
  margin: 0;
  font-size: 1.5rem;
  font-weight: 600;
}
.error-desc {
  margin: 0;
  font-size: 1rem;
  color: var(--color-muted);
  line-height: 1.5;
}
.error-actions {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 0.5rem;
}
.error-btn {
  display: inline-block;
  padding: 0.75rem 1.5rem;
  border-radius: var(--radius-md);
  background: var(--color-primary);
  color: var(--color-primary-foreground);
  text-decoration: none;
  font-weight: 600;
  border: none;
  cursor: pointer;
  font-family: inherit;
  transition: filter 0.2s;
}
.error-btn:hover {
  filter: brightness(1.1);
}
.error-btn.secondary {
  background: transparent;
  border: 1px solid var(--color-border);
  color: var(--color-foreground);
}
.error-btn.secondary:hover {
  background: var(--color-surface);
  border-color: var(--color-primary);
}
</style>
