---
import BaseLayout from "./BaseLayout.astro";
import Sidebar from "../components/layout/Sidebar.vue";
import BottomNav from "../components/layout/BottomNav.vue";
import ToasterWrapper from "../components/ui/ToasterWrapper.vue";
import AuthInitializer from "../components/AuthInitializer.vue";

interface Props {
  title?: string;
  noScroll?: boolean;
}

const { title, noScroll = false } = Astro.props;
const currentPath = Astro.url.pathname;
---

<BaseLayout title={title}>
  <div class="flex h-dvh overflow-hidden bg-[--color-background]">
    <!-- Desktop Sidebar -->
    <div class="hidden lg:flex">
      <Sidebar client:idle currentPath={currentPath} />
    </div>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0 relative">
      <main
        id="main-content"
        role="main"
        class:list={[
          "flex-1 relative min-h-0",
          !noScroll && "overflow-y-auto p-4 pb-24 lg:p-6 xl:p-8 safe-area-pb",
          noScroll && "overflow-hidden"
        ]}
      >
        <div class="animate-fade-in max-w-7xl mx-auto w-full">
          <slot />
        </div>
      </main>

      <!-- Mobile Bottom Navigation -->
      <div class="flex lg:hidden safe-area-pb border-t border-[--glass-border] bg-black/50 backdrop-blur-xl">
        <BottomNav client:idle currentPath={currentPath} />
      </div>
    </div>
  </div>

  <!-- Root initializers -->
  <AuthInitializer client:idle />
  <ToasterWrapper client:idle />
</BaseLayout>
