---
import BaseLayout from "./BaseLayout.astro";
import Sidebar from "../components/layout/Sidebar.vue";
import BottomNav from "../components/layout/BottomNav.vue";
import ToasterWrapper from "../components/ui/ToasterWrapper.vue";
import AuthInitializer from "../components/AuthInitializer.vue";

interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<BaseLayout title={title}>
  <div class="flex min-h-dvh">
    <div class="hidden lg:flex">
      <Sidebar client:idle />
    </div>

    <main
      id="main-content"
      role="main"
      class="flex-1 overflow-y-auto p-4 pb-22 lg:p-6 xl:p-8 safe-area-pb"
    >
      <div class="animate-fade-in">
        <slot />
      </div>
    </main>
  </div>

  <div class="flex lg:hidden safe-area-pb">
    <BottomNav client:idle />
  </div>

  <!-- Root initializers -->
  <AuthInitializer client:idle />
  <ToasterWrapper client:idle />
</BaseLayout>
