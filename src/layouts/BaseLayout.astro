---
import '../styles/global.css'
import '../styles/typography.css'
import '../styles/accessibility.css'
import '../styles/performance.css'
import { withBase } from '../lib/withBase'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Aprende JavaScript',
  description = 'Cuaderno de exploración técnica: 9 lecciones prácticas de JavaScript con quiz formativo.',
} = Astro.props

const themeInitScript = "(function(){const saved=localStorage.getItem('theme');const prefersDark=window.matchMedia('(prefers-color-scheme: dark)').matches;const theme=saved||(prefersDark?'dark':'light');document.documentElement.setAttribute('data-theme',theme);})();"
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F2F1E8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1A2B36" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{title} | game-learning</title>
    <script is:inline set:html={themeInitScript}></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Saltar al contenido principal</a>
    <slot />
  </body>
</html>
